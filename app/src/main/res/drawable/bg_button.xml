<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="6dp" />
            <gradient
                android:angle="270"
                android:endColor="#6A7583"
                android:startColor="#2F3741" />
            <stroke
                android:width="1dp"
                android:color="#33000000" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="6dp" />
            <gradient
                android:angle="270"
                android:endColor="#56606E"
                android:startColor="#8E99A9" />
            <stroke
                android:width="1dp"
                android:color="#33000000" />
        </shape>
    </item>
</selector>