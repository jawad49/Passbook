<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="8dp" />
            <gradient
                android:angle="270"
                android:endColor="#E4E4E7"
                android:startColor="#A9A9AF" />
            <stroke
                android:width="1dp"
                android:color="#66404045" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="8dp" />
            <gradient
                android:angle="270"
                android:endColor="#D0D0D5"
                android:startColor="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#66404045" />
        </shape>
    </item>
</selector>