<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="6dp" />
            <gradient
                android:angle="270"
                android:endColor="#E0605A"
                android:startColor="#7A1612" />
            <stroke
                android:width="1dp"
                android:color="#33000000" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="6dp" />
            <gradient
                android:angle="270"
                android:endColor="#A3231F"
                android:startColor="#E9726C" />
            <stroke
                android:width="1dp"
                android:color="#33000000" />
        </shape>
    </item>
</selector>